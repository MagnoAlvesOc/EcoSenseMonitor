{
  "name": "Estacoes",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da esta\u00e7\u00e3o"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da esta\u00e7\u00e3o"
    },
    "latitude": {
      "type": "number",
      "description": "Latitude da esta\u00e7\u00e3o"
    },
    "longitude": {
      "type": "number",
      "description": "Longitude da esta\u00e7\u00e3o"
    },
    "ip_local": {
      "type": "string",
      "description": "\u00daltimo IP local conhecido"
    },
    "status": {
      "type": "string",
      "enum": [
        "online",
        "offline",
        "manutencao"
      ],
      "default": "offline"
    },
    "ultima_sincronizacao": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "nome",
    "latitude",
    "longitude"
  ]
}