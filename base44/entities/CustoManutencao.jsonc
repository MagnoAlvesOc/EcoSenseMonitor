{
  "name": "CustoManutencao",
  "type": "object",
  "properties": {
    "estacao_id": {
      "type": "string"
    },
    "estacao_nome": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "peca",
        "tecnico",
        "transporte",
        "equipamento",
        "outro"
      ],
      "description": "Tipo do custo"
    },
    "descricao": {
      "type": "string"
    },
    "valor": {
      "type": "number"
    },
    "data": {
      "type": "string",
      "format": "date"
    },
    "fornecedor": {
      "type": "string"
    },
    "nota_fiscal": {
      "type": "string"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "estacao_id",
    "tipo",
    "valor",
    "data"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}